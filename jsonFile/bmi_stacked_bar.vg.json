{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 300,
  "height": 120,

  "data": {
    "url": "data/bmi_adult_by_sex.csv"
  },

  "mark": {
    "type": "bar",
    "height": 45
  },

  "encoding": {
    "y": {
      "field": "Gender",
      "type": "nominal",
      "title": null,
      "sort": ["Men", "Women"]
    },

    "order": {
      "field": "Category_Order",
      "type": "quantitative",
      "sort": "ascending"
    },

    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage (%)",
      "stack": "zero"
    },

    "color": {
      "field": "Category",
      "type": "nominal",
      "title": "BMI Category",
      "scale": {
        "domain": [
          "Underweight",
          "Normal",
          "Overweight",
          "Obese Class I",
          "Obese Class II",
          "Obese Class III"
        ],
        "range": [
          "#D8CCF0",
          "#B7A7E6",
          "#9C6ADE",
          "#F3D27A",
          "#F4A261",
          "#E76F00"
        ]
      }
    },

    "tooltip": [
      {"field": "Gender", "type": "nominal"},
      {"field": "Category", "type": "nominal"},
      {"field": "Percentage", "type": "quantitative", "title": "Percentage (%)"}
    ]
  },

  "config": {
    "background": "#faeab4",

    "view": {
      "stroke": "transparent"
    },

    "axis": {
      "labelFont": "Fredoka",
      "titleFont": "Fredoka",
      "labelFontSize": 13,
      "titleFontSize": 14
    },

    "legend": {
      "labelFont": "Fredoka",
      "titleFont": "Fredoka",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}