{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 400,
  "height": 220,

  "data": {
    "url": "data/obeseAgeGroup.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#4b2e83",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "Age group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65 and over"],
          "title": null
        },
        "x": {
          "field": "Obese",
          "type": "quantitative",
          "title": "Percentage (%)"
        },
        "x2": {
          "field": "Overweight"
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 90,
        "color": "#4b2e83"
      },
      "encoding": {
        "y": {
          "field": "Age group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65 and over"],
          "title": null
        },
        "x": {
          "field": "Obese",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "Age group", "type": "nominal"},
          {"field": "Obese", "type": "quantitative", "title": "Obese (%)"}
        ]
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 90,
        "fill": "#f8f5ef",
        "stroke": "#e76f00",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "Age group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65 and over"],
          "title": null
        },
        "x": {
          "field": "Overweight",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "Age group", "type": "nominal"},
          {"field": "Overweight", "type": "quantitative", "title": "Overweight (%)"}
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "x": 120,
            "y": 120
          }
        ]
      },
      "mark": {
        "type": "rect",
        "width": 185,
        "height": 55,
        "cornerRadius": 8,
        "fill": "#fff8dc",
        "stroke": "#8c7b6b",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "x": 120,
            "y": 100,
            "note": [
                "The wider gap among young adults",
                "suggests overweight is more common",
                "than obesity. As age increases,",
                "obesity prevalence rises, reducing",
                "the difference between categories."
              ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 8,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle",
        "lineHeight": 10,
        "color": "#6b4f3b"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],

  "config": {
    "background": "#faeab4",
    "view": {
      "stroke": null
    }
  }
}