{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 140,
  "height": 200,

  "data": {
    "url": "data/consumerBehaviourQSR.csv"
  },

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },

  "encoding": {
    "y": {
      "field": "Consumer Behaviour",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 300
      }
    },

    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage (%)"
    },

    "color": {
      "field": "Percentage",
      "type": "quantitative",
      "scale": {
        "scheme": "oranges"
      },
      "legend": null
    },

    "tooltip": [
      {
        "field": "Consumer Behaviour",
        "type": "nominal"
      },
      {
        "field": "Percentage",
        "type": "quantitative"
      }
    ]
  },

  "config": {
  "background": "#faeab4",

  "view": {
    "stroke": null
  },

  "axis": {
    "labelFont": "Rubik",
    "titleFont": "Rubik",

    "labelFontSize": 10,
    "titleFontSize": 13,

    "labelFontWeight": "bold",
    "titleFontWeight": "bold"
  }
}
}