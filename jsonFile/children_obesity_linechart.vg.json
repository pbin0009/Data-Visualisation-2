{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 520,
  "height": 180,

  "data": {
    "url": "data/children_obesity_trend.csv"
  },

  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 80
    },
    "strokeWidth": 4
  },

  "encoding": {
    "x": {
    "field": "Year",
    "type": "ordinal",
    "title": null,

    "axis": {
        "labelAngle": 0
    }
    },

    "y": {
      "field": "Rate",
      "type": "quantitative",
      "title": "Rate (%)"
    },

    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "range": ["#4b2e83", "#e76f00"]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": null
      }
    },

    "tooltip": [
      {"field": "Year", "type": "ordinal"},
      {"field": "Category", "type": "nominal"},
      {"field": "Rate", "type": "quantitative", "title": "Rate (%)"}
    ]
  },

  "config": {
    "background": "#faeab4",
    "view": {
      "stroke": null
    }
  }
}