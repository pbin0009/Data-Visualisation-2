{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 250,
  "height": 280,

  "data": {
    "url": "data/bmiAdultDistribution.csv"
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "x": {
      "field": "Gender",
      "type": "nominal",
      "title": "Gender",
      "sort": ["Male", "Female"]
    },

    "y": {
      "field": "BMI_Range",
      "type": "nominal",
      "title": "BMI Range",
      "sort": [
        "Less than 18.5",
        "18.5 to less than 20.5",
        "20.5 to less than 22.5",
        "22.5 to less than 24.5",
        "24.5 to less than 26.5",
        "26.5 to less than 28.5",
        "28.5 to less than 30.5",
        "30.5 to less than 32.5",
        "32.5 to less than 34.5",
        "34.5 to less than 36.5",
        "36.5 to less than 38.5",
        "38.5 to less than 40.5",
        "40.5 to less than 42.5",
        "42.5 to less than 44.5",
        "44.5 to less than 46.5",
        "46.5 or more"
      ]
    },

    "color": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage (%)",
      "scale": {
        "scheme": "oranges"
      }
    },

    "tooltip": [
      {
        "field": "Gender",
        "type": "nominal",
        "title": "Gender"
      },
      {
        "field": "BMI_Range",
        "type": "nominal",
        "title": "BMI Range"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Percentage (%)"
      }
    ]
  },

  "config": {
    "background": "#faeab4",

    "view": {
      "stroke": "transparent"
    },

    "axis": {
      "labelFont": "Fredoka",
      "titleFont": "Fredoka",
      "labelFontSize": 11,
      "titleFontSize": 13
    },

    "legend": {
      "labelFont": "Fredoka",
      "titleFont": "Fredoka",
      "labelFontSize": 11,
      "titleFontSize": 13
    }
  }
}