{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 280,
  "height": 210,

  "data": {
    "url": "data/avgSpendingByState.csv"
  },

  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },

    "x": {
      "field": "AUD",
      "type": "quantitative",
      "title": "Average monthly spend (AUD)"
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 6,
        "color": "#4b2e83"
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 250,
        "color": "#e76f00"
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "AUD",
          "type": "quantitative"
        }
      }
    }
  ],

  "config": {
  "background": "#faeab4",

  "view": {
    "stroke": null
  },

  "axis": {
    "labelFont": "Rubik",
    "titleFont": "Rubik",

    "labelFontSize": 10,
    "titleFontSize": 14,

    "labelFontWeight": "bold",
    "titleFontWeight": "bold"
  }
}
}